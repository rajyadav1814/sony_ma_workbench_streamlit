# Copy to .env (git-ignored). Database settings:
DATABASE_URL=postgresql://user:password@host:5432/catalogue_valuation
APP_SCHEMA=lai_app

# ─── Sign-in: pick one mode ────────────────────────────────────────────────
# oidc (default): company identity provider, configured in .streamlit/secrets.toml
# otp:            code emailed to an allow-listed address (settings below)
# dev:            type any email. LOCAL DEVELOPMENT ONLY, never on a shared or deployed server.
APP_AUTH_MODE=otp

# --- otp mode ---
# Random string, 32+ characters: python -c "import secrets; print(secrets.token_hex(32))"
APP_AUTH_SECRET=
# Who may sign in (at least one is required). Comma-separated.
APP_ALLOWED_EMAILS=
APP_ALLOWED_DOMAINS=
# Mail server that sends the codes (port 465 = SSL, otherwise STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=workbench@example.com
# Optional: code lifetime and how long a device stays signed in, in hours (720 = 30 days)
APP_OTP_TTL_SECONDS=600
APP_SESSION_HOURS=720
