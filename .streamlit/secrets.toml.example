# Copy to .streamlit/secrets.toml (git-ignored) and fill in. Sign-in uses Streamlit's st.login() with any
# OpenID Connect provider (Azure AD / Entra ID, Okta, Google, ...). Requires the Authlib package.
# Docs: https://docs.streamlit.io/develop/concepts/connections/authentication

[auth]
# Must be registered as an allowed redirect URI with the provider. Path is always /oauth2callback.
redirect_uri = "http://localhost:8501/oauth2callback"
# Long random string used to sign the identity cookie, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CHANGE_ME"
client_id = "CHANGE_ME"
client_secret = "CHANGE_ME"
# Azure AD / Entra:  https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# Okta:              https://<your-okta-domain>/.well-known/openid-configuration
# Google:            https://accounts.google.com/.well-known/openid-configuration
server_metadata_url = "https://CHANGE_ME/.well-known/openid-configuration"
